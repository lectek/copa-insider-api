<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <property name="LOG_PATTERN" value="%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
    </encoder>
  </appender>

  <!-- Spring & auto-config -->
  <logger name="org.springframework" level="WARN"/>
  <logger name="org.springframework.boot.autoconfigure" level="INFO"/>
  <logger name="org.springframework.boot.context.properties" level="DEBUG"/>
  <logger name="org.springframework.data.repository.config" level="INFO"/>

  <!-- Hibernate -->
  <logger name="org.hibernate.SQL" level="DEBUG"/>
  <logger name="org.hibernate.orm.jdbc.bind" level="TRACE"/>
  <logger name="org.hibernate.tool.schema" level="WARN"/>

  <!-- Flyway & Testcontainers -->
  <logger name="org.flywaydb.core" level="INFO"/>
  <logger name="org.testcontainers" level="INFO"/>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
